{
  "name": "@luukblankenstijn/agent-bridge",
  "version": "0.5.0",
  "description": "Peer-to-peer mailbox for AI agents, exposed as an MCP server",
  "type": "module",
  "license": "MIT",
  "author": "Luuk Blankenstijn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuukBlankenstijn/agent-bridge.git"
  },
  "bin": {
    "agent-bridge": "dist/src/bin.js"
  },
  "exports": {
    "./server": "./dist/src/opencode-plugin.js",
    "./omp": "./dist/src/omp-extension.js"
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test 'dist/test/**/*.test.js'",
    "prepublishOnly": "node -e \"process.env.GITHUB_ACTIONS || (console.error('Publish by creating a GitHub release; CI publishes it.'), process.exit(1))\" && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "selfsigned": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
